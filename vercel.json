{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.webm",
      "headers": [{ "key": "Content-Type", "value": "video/webm" }, { "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [{ "key": "Content-Type", "value": "video/mp4" }, { "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
